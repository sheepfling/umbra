@PACKAGE_INIT@

set(umbra_rti_ABI_MAJOR_VERSION "@UMBRA_RTI_ABI_MAJOR_VERSION@")
set(umbra_rti_RTI_LIBRARY_NAME "@UMBRA_RTI_LIBRARY_NAME@")
set(umbra_rti_FEDTIME_LIBRARY_NAME "@UMBRA_FEDTIME_LIBRARY_NAME@")
