{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows default",
      "description": "Core native build and offline-friendly baseline tests.",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/cmake/default"
    },
    {
      "name": "windows-catch2",
      "displayName": "Windows Catch2",
      "description": "Native behavior tests; downloads Catch2 when it is not already available.",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/cmake/catch2",
      "cacheVariables": {
        "UMBRA_FETCH_CATCH2": "ON"
      }
    },
    {
      "name": "windows-fom",
      "displayName": "Windows FOM validator",
      "description": "FOM/XML validation tests; downloads the pinned Catch2 and libxml2 dependencies when needed.",
      "inherits": "windows-catch2",
      "binaryDir": "${sourceDir}/out/cmake/fom",
      "cacheVariables": {
        "UMBRA_ENABLE_LIBXML2_FOM_VALIDATOR": "ON",
        "UMBRA_FETCH_LIBXML2": "ON"
      }
    },
    {
      "name": "windows-fom-services",
      "displayName": "Windows installable federation-management profile",
      "description": "Installable embedded FOM-services profile with packaged resources and process endpoint configuration.",
      "inherits": "windows-fom",
      "binaryDir": "${sourceDir}/out/cmake/fom-services",
      "cacheVariables": {
        "UMBRA_ENABLE_EMBEDDED_FEDERATION_MANAGEMENT": "ON"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-scoop.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-default",
      "displayName": "MinGW default",
      "description": "Core native MinGW build and offline-friendly baseline tests.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/out/mgw/default"
    },
    {
      "name": "mingw-catch2",
      "displayName": "MinGW Catch2",
      "description": "Full native behavior tests with the embedded FOM-services profile and shared RTI libraries.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/out/mgw/catch2",
      "cacheVariables": {
        "UMBRA_FETCH_CATCH2": "ON",
        "UMBRA_BUILD_SHARED_LIBRARIES": "ON",
        "UMBRA_EXPORT_INTERNAL_TEST_SYMBOLS": "ON",
        "UMBRA_ENABLE_LIBXML2_FOM_VALIDATOR": "ON",
        "UMBRA_FETCH_LIBXML2": "ON",
        "UMBRA_ENABLE_EMBEDDED_FEDERATION_MANAGEMENT": "ON"
      }
    },
    {
      "name": "mingw-shared",
      "displayName": "MinGW shared-library package",
      "description": "Build and package the three IEEE 1516.1-2025 C++ libraries as shared libraries and run a clean installed consumer.",
      "inherits": "mingw-catch2",
      "binaryDir": "${sourceDir}/out/mgw/shared",
      "cacheVariables": {
        "UMBRA_BUILD_SHARED_LIBRARIES": "ON"
      }
    },
    {
      "name": "mingw-focused-full-debug-static",
      "displayName": "MinGW focused full-debug static",
      "description": "Explicit single-target investigation with full debug symbols and static RTI libraries; not a routine all-tests build.",
      "inherits": "mingw-catch2",
      "binaryDir": "${sourceDir}/out/d",
      "cacheVariables": {
        "UMBRA_BUILD_SHARED_LIBRARIES": "OFF",
        "UMBRA_FULL_DEBUG_TEST_EXECUTABLES": "ON"
      }
    },
    {
      "name": "mingw-fom",
      "displayName": "MinGW FOM validator",
      "description": "FOM/XML validation tests; downloads the pinned Catch2 and libxml2 dependencies when needed.",
      "inherits": "mingw-catch2",
      "binaryDir": "${sourceDir}/out/mgw/fom",
      "cacheVariables": {
        "UMBRA_ENABLE_LIBXML2_FOM_VALIDATOR": "ON",
        "UMBRA_FETCH_LIBXML2": "ON"
      }
    },
    {
      "name": "mingw-fom-services",
      "displayName": "MinGW installable federation-management profile",
      "description": "Installable embedded FOM-services profile with packaged resources and process endpoint configuration.",
      "inherits": "mingw-fom",
      "binaryDir": "${sourceDir}/out/mgw/embedded",
      "cacheVariables": {
        "UMBRA_ENABLE_EMBEDDED_FEDERATION_MANAGEMENT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-default-debug",
      "configurePreset": "windows-default",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-catch2-debug",
      "configurePreset": "windows-catch2",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-fom-debug",
      "configurePreset": "windows-fom",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-fom-services-debug",
      "configurePreset": "windows-fom-services",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "mingw-default-debug",
      "configurePreset": "mingw-default",
      "jobs": 4
    },
    {
      "name": "mingw-catch2-debug",
      "configurePreset": "mingw-catch2",
      "jobs": 4
    },
    {
      "name": "mingw-shared-debug",
      "configurePreset": "mingw-shared",
      "jobs": 4
    },
    {
      "name": "mingw-focused-full-debug-static",
      "configurePreset": "mingw-focused-full-debug-static",
      "jobs": 4
    },
    {
      "name": "mingw-fom-debug",
      "configurePreset": "mingw-fom",
      "jobs": 4
    },
    {
      "name": "mingw-fom-services-debug",
      "configurePreset": "mingw-fom-services",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-default-debug",
      "configurePreset": "windows-default",
      "execution": {
        "jobs": 4
      },
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-catch2-debug",
      "configurePreset": "windows-catch2",
      "execution": {
        "jobs": 4
      },
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-fom-debug",
      "configurePreset": "windows-fom",
      "execution": {
        "jobs": 4
      },
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-fom-services-debug",
      "configurePreset": "windows-fom-services",
      "execution": {
        "jobs": 4
      },
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-default-debug",
      "configurePreset": "mingw-default",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-catch2-debug",
      "configurePreset": "mingw-catch2",
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "name": "_NOT_BUILT-"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-shared-debug",
      "configurePreset": "mingw-shared",
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "name": "_NOT_BUILT-"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-focused-full-debug-static",
      "configurePreset": "mingw-focused-full-debug-static",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-fom-debug",
      "configurePreset": "mingw-fom",
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "name": "_NOT_BUILT-"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-fom-services-debug",
      "configurePreset": "mingw-fom-services",
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "name": "_NOT_BUILT-"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
