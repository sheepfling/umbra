<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2025"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2025 IEEE1516-DIF-2025.xsd">
    <modelIdentification>
        <name>Portable HLA C++ TCK Attribute Relevance Rate FOM</name>
        <type>FOM</type>
        <version>1.0</version>
        <modificationDate>2026-09-11</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <copyright>Public test fixture</copyright>
        <releaseRestriction>NA</releaseRestriction>
        <purpose>Portable IEEE 1516.1-2025 C++ conformance tests</purpose>
        <applicationDomain>Conformance testing</applicationDomain>
        <description>This FOM isolates ordinary attribute relevance advisory reissue behavior when the active maximum update rate changes.</description>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <sharing>Neither</sharing>
            <objectClass>
                <name>TckRateObject</name>
                <sharing>PublishSubscribe</sharing>
                <attribute>
                    <name>BestEffortValue</name>
                    <dataType>HLAbyte</dataType>
                    <updateType>Conditional</updateType>
                    <updateCondition>When changed.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                    <semantics>Portable attribute relevance advisory rate-reissue attribute.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
    <interactions>
        <interactionClass>
            <name>HLAinteractionRoot</name>
            <sharing>Neither</sharing>
        </interactionClass>
    </interactions>
    <switches>
        <autoProvide isEnabled="false"/>
        <attributeRelevanceAdvisory isEnabled="true"/>
        <objectClassRelevanceAdvisory isEnabled="false"/>
        <interactionRelevanceAdvisory isEnabled="false"/>
        <nonRegulatedGrant isEnabled="false"/>
        <allowRelaxedDDM isEnabled="false"/>
        <advisoriesUseKnownClass isEnabled="false"/>
    </switches>
    <updateRates>
        <updateRate>
            <name>TckFast</name>
            <rate>25.0</rate>
            <semantics>Portable higher update-rate designator for attribute relevance advisories.</semantics>
        </updateRate>
        <updateRate>
            <name>TckSlow</name>
            <rate>0.5</rate>
            <semantics>Portable lower update-rate designator for attribute relevance advisories.</semantics>
        </updateRate>
    </updateRates>
</objectModel>
