<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2025"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2025 IEEE1516-DIF-2025.xsd">
    <modelIdentification>
        <name>Portable HLA C++ TCK FOM extension</name>
        <type>FOM</type>
        <version>1.0</version>
        <modificationDate>2026-09-02</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <copyright>Public test fixture</copyright>
        <releaseRestriction>NA</releaseRestriction>
        <purpose>Portable module composition and additional declaration tests</purpose>
        <applicationDomain>Conformance testing</applicationDomain>
        <description>This module is composed with the portable FOM model during a join and create test.</description>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>TckExtensionObject</name>
                <sharing>PublishSubscribe</sharing>
                <attribute>
                    <name>ExtensionValue</name>
                    <dataType>TckExtensionInteger</dataType>
                    <updateType>Static</updateType>
                    <updateCondition>At registration.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                    <semantics>Attribute supplied by the extension module.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
    <interactions>
        <interactionClass>
            <name>HLAinteractionRoot</name>
            <interactionClass>
                <name>TckExtensionInteraction</name>
                <sharing>PublishSubscribe</sharing>
                <transportation>HLAreliable</transportation>
                <order>Receive</order>
                <parameter>
                    <name>ExtensionParameter</name>
                    <dataType>TckExtensionInteger</dataType>
                    <semantics>Parameter supplied by the extension module.</semantics>
                </parameter>
            </interactionClass>
        </interactionClass>
    </interactions>
    <dataTypes>
        <simpleDataTypes>
            <simpleData>
                <name>TckExtensionInteger</name>
                <representation>HLAinteger32BE</representation>
                <units>NA</units>
                <resolution>1</resolution>
                <accuracy>Perfect</accuracy>
                <semantics>Extension-module signed integer.</semantics>
            </simpleData>
        </simpleDataTypes>
    </dataTypes>
</objectModel>
