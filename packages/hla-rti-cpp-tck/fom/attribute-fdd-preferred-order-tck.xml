<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2025"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2025 IEEE1516-DIF-2025.xsd">
    <modelIdentification>
        <name>Portable HLA TCK attribute preferred-order FOM</name>
        <type>FOM</type>
        <version>1.0</version>
        <modificationDate>2026-10-17</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <copyright>Public test fixture</copyright>
        <releaseRestriction>NA</releaseRestriction>
        <purpose>Portable IEEE 1516.1-2025 TCK test fixture</purpose>
        <applicationDomain>Conformance testing</applicationDomain>
        <description>Two object attributes with distinct FDD preferred order types.</description>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <sharing>Neither</sharing>
            <objectClass>
                <name>TckObject</name>
                <sharing>PublishSubscribe</sharing>
                <attribute>
                    <name>Value</name>
                    <dataType>HLAbyte</dataType>
                    <updateType>Periodic</updateType>
                    <updateCondition>As needed.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>TimeStamp</order>
                    <semantics>FDD-preferred timestamp order test attribute.</semantics>
                </attribute>
                <attribute>
                    <name>PayRate</name>
                    <dataType>HLAbyte</dataType>
                    <updateType>Periodic</updateType>
                    <updateCondition>As needed.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                    <semantics>FDD-preferred receive order test attribute.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
</objectModel>
