<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2025"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2025 IEEE1516-DIF-2025.xsd">
    <modelIdentification>
        <name>Portable HLA C++ TCK known-class-disabled advisory model</name>
        <type>FOM</type>
        <version>1.0</version>
        <modificationDate>2026-09-11</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <copyright>Public test fixture</copyright>
        <releaseRestriction>NA</releaseRestriction>
        <purpose>Portable IEEE 1516.1-2025 known-class advisory tests</purpose>
        <applicationDomain>Conformance testing</applicationDomain>
        <description>
            This adapter fixture supplies an inherited object-class pair and
            disables the standard Advisories Use Known Class policy.
        </description>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <sharing>Neither</sharing>
            <objectClass>
                <name>TckKnownClassObject</name>
                <sharing>PublishSubscribe</sharing>
                <attribute>
                    <name>Name</name>
                    <dataType>HLAbyte</dataType>
                    <updateType>Static</updateType>
                    <updateCondition>At registration.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                    <semantics>Attribute visible at the receiver's known class.</semantics>
                </attribute>
                <objectClass>
                    <name>TckKnownClassDerivedObject</name>
                    <sharing>PublishSubscribe</sharing>
                    <attribute>
                        <name>Efficiency</name>
                        <dataType>HLAbyte</dataType>
                        <updateType>Static</updateType>
                        <updateCondition>At registration.</updateCondition>
                        <valueRequired>false</valueRequired>
                        <ownership>DivestAcquire</ownership>
                        <sharing>PublishSubscribe</sharing>
                        <transportation>HLAreliable</transportation>
                        <order>Receive</order>
                        <semantics>Attribute declared only at the derived class.</semantics>
                    </attribute>
                </objectClass>
            </objectClass>
        </objectClass>
    </objects>
    <switches>
        <attributeRelevanceAdvisory isEnabled="true"/>
        <objectClassRelevanceAdvisory isEnabled="false"/>
        <interactionRelevanceAdvisory isEnabled="false"/>
        <advisoriesUseKnownClass isEnabled="false"/>
    </switches>
</objectModel>
