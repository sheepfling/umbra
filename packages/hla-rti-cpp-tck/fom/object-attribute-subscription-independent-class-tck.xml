<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2025"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2025 IEEE1516-DIF-2025.xsd">
    <modelIdentification>
        <name>Portable HLA C++ TCK independent subscription class module</name>
        <type>FOM</type>
        <version>1.0</version>
        <modificationDate>2026-11-14</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <copyright>Public test fixture</copyright>
        <releaseRestriction>NA</releaseRestriction>
        <purpose>Test independent object-class subscription state</purpose>
        <applicationDomain>Conformance testing</applicationDomain>
        <description>
            Supplies a sibling object class for the ordinary unsubscription
            isolation scenario; it is composed with the adapter's base FOM.
        </description>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>TckIndependentObject</name>
                <sharing>PublishSubscribe</sharing>
                <attribute>
                    <name>IndependentValue</name>
                    <dataType>HLAbyte</dataType>
                    <updateType>Conditional</updateType>
                    <updateCondition>On change.</updateCondition>
                    <valueRequired>false</valueRequired>
                    <ownership>DivestAcquire</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                    <semantics>Attribute used to observe an unrelated class subscription.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
</objectModel>
