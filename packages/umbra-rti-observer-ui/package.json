{
  "name": "@umbra/rti-observer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:codegen": "node --test scripts/generate-api.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
